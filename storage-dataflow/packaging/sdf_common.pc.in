prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: sdf_common
Description: Storage Dataflow Stack — common primitives (ring, pool, seqlock, timer, shm, metrics, log, config)
Version: @PROJECT_VERSION@
Requires:
Libs: -L${libdir} -lsdf_common -lpthread
Cflags: -I${includedir}
