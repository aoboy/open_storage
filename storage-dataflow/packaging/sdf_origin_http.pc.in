prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: sdf_origin_http
Description: Storage Dataflow Stack — origin driver (sdf_origin_http)
Version: @PROJECT_VERSION@
Requires: sdf_common sdf_origin
Libs: -L${libdir} -lsdf_origin_http
Cflags: -I${includedir}
