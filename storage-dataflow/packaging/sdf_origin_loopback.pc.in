prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: sdf_origin_loopback
Description: Storage Dataflow Stack — origin driver (sdf_origin_loopback)
Version: @PROJECT_VERSION@
Requires: sdf_common
Libs: -L${libdir} -lsdf_origin_loopback
Cflags: -I${includedir}
