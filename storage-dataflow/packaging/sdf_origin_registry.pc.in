prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: sdf_origin_registry
Description: Storage Dataflow Stack — origin class selector and configuration registry
Version: @PROJECT_VERSION@
Requires: sdf_common sdf_origin sdf_origin_loopback sdf_origin_http
Libs: -L${libdir} -lsdf_origin_registry
Cflags: -I${includedir}
