{
  "title": "Whack-a-Mole dispatch",
  "uid": "sdf-wm",
  "tags": ["sdf", "wm"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cache-fill p99 by arm",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(wm_fill_duration_seconds_bucket[5m])) by (le, arm))",
          "legendFormat": "{{arm}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fill bytes rate by arm",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(wm_fill_bytes_total[5m])) by (arm)",
          "legendFormat": "{{arm}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Allocation discrepancy by path",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "max_over_time(wm_discrepancy[5m])",
          "legendFormat": "path {{path}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Soft-shedding events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(wm_shed_events_total[5m])) by (path)",
          "legendFormat": "path {{path}}"
        }
      ]
    }
  ]
}
