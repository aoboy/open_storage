{
  "title": "ARC pacing",
  "uid": "sdf-arc",
  "tags": ["sdf", "arc"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Release offset",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "arc_offset_ns",
          "legendFormat": "{{pipeline}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Heap depth",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "arc_heap_depth",
          "legendFormat": "{{pipeline}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Added latency p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(arc_added_latency_ns_bucket[5m])) by (le, pipeline))",
          "legendFormat": "{{pipeline}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dropped entries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(arc_dropped_total[1h]))",
          "legendFormat": "dropped / 1h"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Engine apply p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "engine_apply_p99_seconds",
          "legendFormat": "{{pipeline}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backpressure events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(engine_backpressure_events_total[5m]))",
          "legendFormat": "events/s"
        }
      ]
    }
  ]
}
