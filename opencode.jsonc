{
  "$schema": "https://opencode.ai/config.json",
  // Format in-scope C after OpenCode write/edit operations. The project script
  // silently leaves vendored, generated, and out-of-scope files unchanged.
  "formatter": {
    "clang-format": {
      "command": [
        "storage-dataflow/scripts/format_c.sh",
        "--write-file",
        "$FILE",
      ],
      "extensions": [".c", ".h"],
    },
  },
}
